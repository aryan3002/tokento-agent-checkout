// ============================================================
// Tokento — Prisma Schema
// ============================================================
// Maps directly to the database tables described in the vault's
// Token Architecture and Implementation Plan.
//
// Tables:
//   merchants, earn_rules, tokens, wallets, redemptions,
//   audit_logs, api_keys, idempotency_records, webhook_endpoints,
//   webhook_deliveries

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Merchants ----

model Merchant {
  id               String           @id @default(uuid())
  name             String
  email            String           @unique
  agentOptIn       Boolean          @default(true)
  // DECLARATIVE ONLY — no code branches on either field yet. Settlement is not
  // implemented (no ledger, no payout pipeline), so these record intent for a
  // future settlement engine and change nothing about current behaviour.
  settlementType   String           @default("discount")   // discount | cashback | credit
  settlementTiming String           @default("real_time")   // real_time | daily_batch
  webhookUrl       String?
  webhookSecret    String?
  // PayPal account (sandbox business email) that receives settlement Payouts.
  paypalPayoutEmail String?
  isSandbox        Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  earnRules         EarnRule[]
  tokens            Token[]
  apiKeys           ApiKey[]
  redemptions       Redemption[]
  webhookEndpoints  WebhookEndpoint[]
  products          Product[]
  checkoutOrders    CheckoutOrder[]
  settlementBatches SettlementBatch[]
  agentComparisons  AgentComparison[]

  @@map("merchants")
}

// ---- Earn Rules ----

model EarnRule {
  id                      String   @id @default(uuid())
  merchantId              String
  name                    String
  spendThreshold          Decimal    @default(0) @db.Decimal(12, 2)
  tokenDenomination       Decimal @db.Decimal(12, 2)
  expiryDays              Int      @default(90)
  categoryRestriction     String?
  channelRestriction      String?
  stackabilityFlag        Boolean  @default(true)
  agentPresentableFlag    Boolean  @default(true)    // Default ON per decision log
  minimumTransactionFloor Decimal    @default(0) @db.Decimal(12, 2)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  tokens   Token[]

  @@index([merchantId])
  @@map("earn_rules")
}

// ---- Tokens ----

model Token {
  id                      String   @id @default(uuid())
  merchantId              String
  customerId              String
  earnRuleId              String
  denomination            Decimal @db.Decimal(12, 2)
  tokenType               String   @default("loyalty")  // loyalty | pricing | returns
  status                  String   @default("ACTIVE")    // ACTIVE | REDEEMED | EXPIRED
  signature               String                          // HMAC-SHA256
  idempotencyKey          String
  
  // Conditions (inherited from earn rule at mint time)
  categoryRestriction     String?
  channelRestriction      String?
  stackabilityFlag        Boolean  @default(true)
  agentPresentableFlag    Boolean  @default(true)
  minimumTransactionFloor Decimal    @default(0) @db.Decimal(12, 2)

  // Timestamps
  issuedAt   DateTime  @default(now())
  expiryAt   DateTime
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Environment
  isSandbox Boolean @default(true)

  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  earnRule   EarnRule     @relation(fields: [earnRuleId], references: [id])
  wallet     Wallet       @relation(fields: [customerId], references: [customerId])
  redemption Redemption?

  @@unique([idempotencyKey, merchantId])
  @@index([customerId, status])
  @@index([merchantId, status])
  @@index([expiryAt])
  @@map("tokens")
}

// ---- Wallets ----

model Wallet {
  customerId String   @id
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tokens Token[]

  @@map("wallets")
}

// ---- Redemptions ----
// Append-only redemption log

model Redemption {
  id                 String   @id @default(uuid())
  tokenId            String   @unique
  merchantId         String
  customerId         String
  transactionAmount  Decimal @db.Decimal(12, 2)
  tokenDenomination  Decimal @db.Decimal(12, 2)
  netValue           Decimal @db.Decimal(12, 2)
  agentId            String?
  settlementRef      String   @default(uuid())
  redeemedAt         DateTime @default(now())

  token    Token    @relation(fields: [tokenId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([customerId])
  @@index([redeemedAt])
  @@map("redemptions")
}

// ---- API Keys ----

model ApiKey {
  id         String    @id @default(uuid())
  merchantId String
  keyPrefix  String                          // First 8 chars for display
  keyHash    String    @unique               // SHA-256 hash
  scopes     String[]                         // Array of scope strings
  rateLimit  Int       @default(60)
  isSandbox  Boolean   @default(true)
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([keyHash])
  @@map("api_keys")
}

// ---- Audit Logs ----
// 100% API call coverage, queryable, 90-day retention

model AuditLog {
  id             String   @id @default(uuid())
  method         String
  endpoint       String
  merchantId     String?
  customerId     String?
  tokenId        String?
  requestBody    Json?
  responseCode   Int
  responseTimeMs Int
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime @default(now())

  @@index([merchantId])
  @@index([customerId])
  @@index([tokenId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ---- Idempotency Records ----
// 24hr TTL, generic middleware

model IdempotencyRecord {
  id           String   @id @default(uuid())
  key          String   @unique
  method       String
  endpoint     String
  responseCode Int
  responseBody Json
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// ---- Webhook Endpoints ----

model WebhookEndpoint {
  id         String   @id @default(uuid())
  merchantId String
  url        String
  secret     String
  events     String[]
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant   Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([merchantId])
  @@map("webhook_endpoints")
}

// ---- Webhook Deliveries ----

model WebhookDelivery {
  id                 String    @id @default(uuid())
  webhookEndpointId  String
  eventType          String
  payload            Json
  responseCode       Int?
  responseBody       String?
  attempts           Int       @default(0)
  nextRetryAt        DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime  @default(now())

  webhookEndpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@index([webhookEndpointId])
  @@index([nextRetryAt])
  @@map("webhook_deliveries")
}

// ============================================================
// Agent checkout (PayPal)
// ============================================================

// ---- Products ----
// Demo catalog for the fictional stores. Stands in for each store's product feed.

model Product {
  id          String   @id @default(uuid())
  merchantId  String
  sku         String
  name        String
  description String?
  category    String
  price       Decimal  @db.Decimal(12, 2)
  imageUrl    String?
  isActive    Boolean  @default(true)
  isSandbox   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant         Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  checkoutOrders   CheckoutOrder[]
  agentComparisons AgentComparison[]

  @@unique([merchantId, sku])
  @@index([category])
  @@map("products")
}

// ---- Checkout Orders ----
// One agent purchase: the reward held, the PayPal order, the capture, the reward
// redeemed and the reward earned. Every external effect is keyed off this row's id,
// so each step can be retried safely.

model CheckoutOrder {
  id                       String    @id @default(uuid())
  customerId               String
  merchantId               String
  productId                String
  quantity                 Int       @default(1)
  subtotal                 Decimal   @db.Decimal(12, 2)
  // The hold. Unique, so one reward can back only one open order at a time.
  // Cleared when the order is cancelled or fails.
  rewardTokenId            String?   @unique
  rewardAmount             Decimal   @default(0) @db.Decimal(12, 2)
  amountToPay              Decimal   @db.Decimal(12, 2)
  currency                 String    @default("USD")
  earnRuleId               String?
  expectedEarn             Decimal   @default(0) @db.Decimal(12, 2)
  earnedTokenId            String?   @unique
  redemptionId             String?   @unique
  redemptionSettlementRef  String?
  // Replacement for the spent reward after a refund.
  reissuedTokenId          String?   @unique
  status                   String    @default("PENDING")
  paymentMode              String    @default("approval") // approval | vault
  outsideMandate           Boolean   @default(false)
  mandateId                String?
  agentId                  String?
  agentReason              String?
  idempotencyKey           String
  paypalOrderId            String?   @unique
  paypalCaptureId          String?   @unique
  paypalRefundId           String?   @unique
  approvalUrl              String?
  platformFee              Decimal   @default(0) @db.Decimal(12, 2)
  settlementId             String?
  refundNettedSettlementId String?
  note                     String?
  isSandbox                Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  completedAt              DateTime?
  refundedAt               DateTime?

  merchant               Merchant         @relation(fields: [merchantId], references: [id])
  product                Product          @relation(fields: [productId], references: [id])
  settlement             SettlementBatch? @relation("SettlementOrders", fields: [settlementId], references: [id])
  refundNettedSettlement SettlementBatch? @relation("SettlementRefunds", fields: [refundNettedSettlementId], references: [id])

  @@unique([customerId, idempotencyKey])
  @@index([merchantId, status])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("checkout_orders")
}

// ---- Agent Comparisons ----
// One line per store each time a shopper's agent compares offers from two or more
// stores: was this store recommended, and did its rewards decide it? A store only
// ever reads its own lines (never another store's name or price).

model AgentComparison {
  id             String   @id @default(uuid())
  // Groups the lines of one comparison.
  comparisonId   String
  merchantId     String
  // The store's best offer in the comparison.
  productId      String
  outcome        String // won_with_rewards | won_on_price | not_chosen
  quantity       Int
  subtotal       Decimal  @db.Decimal(12, 2)
  effectiveCost  Decimal  @db.Decimal(12, 2)
  storesCompared Int
  isSandbox      Boolean  @default(true)
  createdAt      DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, merchantId])
  @@index([merchantId, isSandbox, createdAt])
  @@map("agent_comparisons")
}

// ---- PayPal Webhook Events ----
// Every delivery, keyed by PayPal's event id so redeliveries are recognised.

model PaypalWebhookEvent {
  id          String    @id
  eventType   String
  resourceId  String?
  verified    Boolean
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([eventType])
  @@index([receivedAt])
  @@map("paypal_webhook_events")
}

// ---- Spending Mandates ----
// What the shopper lets an agent spend without asking. Optionally backed by a
// PayPal vault token so purchases inside it need no new approval.

model Mandate {
  id                   String    @id @default(uuid())
  customerId           String
  perPurchaseMax       Decimal   @db.Decimal(12, 2)
  monthlyCap           Decimal   @db.Decimal(12, 2)
  allowedMerchantIds   String[]
  expiresAt            DateTime
  status               String    @default("ACTIVE")  // ACTIVE | REVOKED
  vaultStatus          String    @default("NONE")    // NONE | PENDING_APPROVAL | ACTIVE | FAILED
  paypalSetupTokenId   String?   @unique
  paypalPaymentTokenId String?
  paypalCustomerId     String?
  isSandbox            Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  revokedAt            DateTime?

  @@index([customerId, status])
  @@map("mandates")
}

// ---- Settlement Batches ----
// One PayPal Payouts batch paying a store for its completed agent orders,
// minus the platform fee and any refunds of orders paid out earlier.

model SettlementBatch {
  id                  String    @id @default(uuid())
  merchantId          String
  status              String    @default("PENDING") // PENDING | PROCESSING | SUCCESS | DENIED | FAILED
  gross               Decimal   @db.Decimal(12, 2)
  fees                Decimal   @db.Decimal(12, 2)
  refundAdjustments   Decimal   @default(0) @db.Decimal(12, 2)
  net                 Decimal   @db.Decimal(12, 2)
  receiverEmail       String
  paypalPayoutBatchId String?   @unique
  error               String?
  isSandbox           Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  completedAt         DateTime?

  merchant       Merchant        @relation(fields: [merchantId], references: [id])
  orders         CheckoutOrder[] @relation("SettlementOrders")
  refundedOrders CheckoutOrder[] @relation("SettlementRefunds")

  @@index([merchantId, createdAt])
  @@map("settlement_batches")
}
